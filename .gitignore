# --- virtual environment / Python ---
.venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
# setuptools' legacy bdist_wheel leaves bdist/ or bdist.<platform>-<arch>/
# (e.g. build\bdist.win-amd64\wheel inside build/, but top-level too).
bdist*/

# --- secrets: NEVER commit ---
.env

# --- signing keys / local runtime data: NEVER commit ---
data/

# --- runtime artifacts ---
*.log
pytest.out
pytest.err
.pytest_cache/
# Tool caches (ruff/mypy write these into the repo root)
.ruff_cache/
.mypy_cache/
