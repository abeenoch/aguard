# A-guard — local configuration template
# Copy to .env and fill in real values. .env is gitignored — never commit it.
# Generate secrets: python -c "import secrets; print(secrets.token_hex(32))"

# --- Database ---
# Superuser password: only used by tests to apply app/db/schema.sql
PG_SUPERUSER_PASSWORD=

# Pool DSNs must match the passwords in app/db/schema.sql (dev defaults shown).
# DB_DSN_HUMAN=postgresql://app_login_human:human-pool-secret-dev@localhost:5432/agent_auth
# DB_DSN_AGENT=postgresql://app_login_agent:agent-pool-secret-dev@localhost:5432/agent_auth

# --- Security secrets (dev defaults live in app/settings.py; override for any shared deployment) ---
# SESSION_SECRET=
# LOG_HASH_PEPPER=

# --- Demo client secrets (seeded defaults are public; override for shared deployments) ---
# DEMO_CONF_SECRET=demo-conf-secret
# CLI_AGENT_SECRET=cli-agent-secret
# CHAT_AGENT_SECRET=chat-agent-secret

# --- MCP / RFC 8707 (resource indicators) ---
# MCP_RESOURCE_ID=http://localhost:8000/mcp
# ALLOWED_RESOURCES=http://localhost:8000/mcp,http://localhost:8000/api
