# A-guard — local configuration template
# Copy to .env and fill in real values. .env is gitignored — never commit it.
# Generate secrets: python -c "import secrets; print(secrets.token_hex(32))"

# --- Database ---
# Superuser password: only used by tests to apply aguard/db/schema.sql
PG_SUPERUSER_PASSWORD=

# Pool DSNs must match the passwords in aguard/db/schema.sql (dev defaults shown).
# DB_DSN_HUMAN=postgresql://app_login_human:human-pool-secret-dev@localhost:5432/agent_auth
# DB_DSN_AGENT=postgresql://app_login_agent:agent-pool-secret-dev@localhost:5432/agent_auth
# DB_DSN_AUTH=postgresql://app_login_auth:auth-pool-secret-dev@localhost:5432/agent_auth

# --- Issuer + the two services -------------------------------------------
# The authorization server and the MCP resource server are SEPARATE services
# on separate ports. The issuer is the URL clients reach the AS at.
# OIDC_ISSUER=https://auth.example.com/api
# MCP_RESOURCE_URL=https://auth.example.com/mcp
# MCP_RESOURCE_ID=https://auth.example.com/mcp
# ALLOWED_RESOURCES=https://auth.example.com/mcp,https://auth.example.com/api
#
# Where a containerised resource server fetches the AS's JWKS. Leave unset when
# both run on one host; set it to the INTERNAL address when the public issuer
# name does not resolve from inside the resource server's network.
# JWKS_URI=https://auth.example.com/api/jwks
#
# Reaching the MCP resource server from OFF-BOX: the SDK's DNS-rebinding
# protection allows loopback only, so a public host must be listed or every
# request is refused (421). Comma-separated HOSTS (no scheme). The "host:*" form
# matches any PORT on that host, but only when the Host header actually carries a
# port — a default-port URL (https:// on 443) sends the BARE name, so list both.
# MCP_ALLOWED_HOSTS=auth.example.com,auth.example.com:*
# MCP_ALLOWED_ORIGINS=https://auth.example.com:*

# --- Authorization state storage ---
# memory   = single process only (default; zero setup)
# postgres = shared + restart-durable. REQUIRED before running more than one
#            worker: single-use code tombstones and refresh-family revocation
#            are security state, and per-process state means a replay served
#            by another worker goes undetected.
# STORE_BACKEND=postgres

# --- Rate limiting (see aguard/ratelimit.py) ---
# Attempts allowed per identity per window. Windows are fixed in code (60s for
# /token and /login, 300s per account, 1h for /register); only these counts are
# tunable. The defaults suit one human at a browser — a machine client that
# legitimately bursts needs a higher RATE_LIMIT_TOKEN.
# RATE_LIMIT_TOKEN=60
# RATE_LIMIT_LOGIN=10
# RATE_LIMIT_LOGIN_ACCOUNT=5
# RATE_LIMIT_REGISTER=10

# Counters are PER PROCESS: with N workers the effective ceiling is N x limit.
# Where attempts are counted. memory = per-process counters (correct for a
# single worker; N workers enforce N x the limit). postgres = shared counters
# (correct across workers, durable across restart); requires the
# rate_limit_buckets table from aguard/db/schema.sql.
# RATE_LIMIT_BACKEND=memory

# Trust X-Forwarded-For when deriving the caller's identity. The default (false)
# is the security-relevant one: the header is client-supplied, so trusting it
# with no proxy in front hands an attacker unlimited fresh identities. Enable
# only behind a proxy you control that overwrites the header.
# RATE_LIMIT_TRUST_FORWARDED_FOR=false

# --- Session cookies (aguard/oidc/session.py) ---
# Browser session lifetime. The cookie's Max-Age and the token's own exp are
# both derived from this one number, so they cannot drift apart.
# SESSION_TTL=28800

# Send the session cookie only over TLS. "auto" (the default) derives it from
# the issuer scheme: an https issuer marks the cookie Secure, an
# http://localhost dev issuer leaves it unmarked (a Secure cookie is useless
# there). Force "true" when TLS terminates in front of an http issuer; an
# unrecognised value behaves like "auto", never like "false", so a typo cannot
# silently downgrade the cookie to plaintext transport.
# SESSION_COOKIE_SECURE=auto

# --- Readiness probe (/readyz) ---
# How long a readiness result may be reused. Each probe costs a database
# connection and infrastructure polls every few seconds, so a short cache stops
# polling from draining the pool that /token also borrows from. 0 = probe on
# every request (what the test suite uses).
# READYZ_CACHE_SECONDS=1.0

# --- Introspection (/introspect, RFC 7662) ---
# Clients allowed to introspect tokens they do NOT own. Empty (the default) =
# owner-only: a client may only ask about tokens issued to itself. A resource
# server or ops tool that must inspect arbitrary tokens has to be named here.
# Only ever list CONFIDENTIAL clients: a public client authenticates by name
# alone, so allowlisting one would reopen the hole this closes.
# INTROSPECTION_CLIENTS=ops-tool

# --- Security secrets (dev defaults live in aguard/settings.py; override for any shared deployment) ---
# SESSION_SECRET=
# LOG_HASH_PEPPER=

# --- Demo client secrets (seeded defaults are public; override for shared deployments) ---
# DEMO_CONF_SECRET=demo-conf-secret
# CLI_AGENT_SECRET=cli-agent-secret
# CHAT_AGENT_SECRET=chat-agent-secret

# --- Signing keys (aguard/oidc/signers.py) -------------------------------
# file  = generate/persist an unencrypted keystore under KEY_DIR (dev default).
# env   = take the PEM from the environment; never written to disk.
# aws-kms | gcp-kms | vault = sign in the KMS/HSM; the private key NEVER enters
#         this process. Install the matching extra: a-guard[kms-aws] / [kms-gcp]
#         (Vault uses the standard library and needs no extra).
# KEY_SOURCE=file
#
# For KEY_SOURCE=env: the active PKCS#8 private key, plus optional retired keys
# kept only so their still-valid tokens verify (public PEMs are fine for those).
# SIGNING_KEY_PEM=
# SIGNING_KEY_RETIRED_PEMS=
#
# For KEY_SOURCE=aws-kms|gcp-kms|vault: the key id/name. Vault reads VAULT_ADDR
# and VAULT_TOKEN from the environment (or set them here).
# KMS_KEY_ID=
# KMS_REGION=
# VAULT_ADDR=
# VAULT_TOKEN=

# --- DCR redirect-URI policy (default: strict) ---
# Empty by default: https anywhere, http on loopback only (RFC 8252).
# Editor-extension MCP hosts register a private-use scheme instead of a
# loopback port. Cline uses vscode://saoudrizwan.claude-dev/mcp-auth/callback/<hash>,
# which cannot be pre-registered. Opt in per client, e.g.:
# DCR_ALLOWED_REDIRECT_SCHEMES=vscode

# --- Accounts (/login, /signup) -------------------------------------------
# Self-service sign-up: anybody can create an account and use it. ON by default
# — that is the point of a public deployment — and rate-limited like /register.
# Set to false to close registration without a code change.
# ALLOW_SIGNUP=true
#
# The demo identities (alice@example.com / bob@example.com) are seeded on every
# start into whichever directory backend is in use. Their passwords are printed
# in the README, so a real deployment sets this to false and lets visitors use
# /signup instead.
# SEED_DEMO_USERS=true

# --- /redact playground (MCP resource server) ------------------------------
# The unauthenticated "try the engine with a curl" endpoint at /redact. These
# are its only knobs; both defaults are deliberate (see aguard/mcp/service.py).
# Requests per caller address per 60s window — the tightest budget shipped,
# because the endpoint's abuse ceiling is "free regex service".
# RATE_LIMIT_REDACT=10
# Refuse larger submissions before any regex work (bytes of CPU per request
# must not follow bytes of input).
# REDACT_ENDPOINT_MAX_CHARS=10000
